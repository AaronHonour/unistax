# Required: HS256 signing secret, at least 32 characters, e.g. `openssl rand -hex 32`
UNISTAX_AGENT_API_JWT_SECRET=
POSTGRES_PASSWORD=
# Optional: comma-separated browser origins allowed to call the API (no wildcard)
UNISTAX_AGENT_API_CORS_ORIGINS=

# Optional: a PostgreSQL database for the Steward/Engineer agents to inspect. Use a dedicated
# SELECT-only role (the service refuses superusers). Leave empty to keep results simulated.
UNISTAX_AGENT_API_DATASOURCE_URL=
UNISTAX_AGENT_API_DATASOURCE_SCHEMAS=public

# Optional: LLM swarms via the Claude Code CLI (single operator; see "Agent swarm" in AGENTS.md).
# Needs the `claude` CLI installed and logged in on the machine running the service, which the
# provided Docker image does not include. Leave as "none" to disable.
UNISTAX_AGENT_API_LLM_BACKEND=none
