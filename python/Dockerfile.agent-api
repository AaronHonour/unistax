# syntax=docker/dockerfile:1
# Agent framework API service.
#   docker build -f Dockerfile.agent-api -t unistax-agent-api .
#   docker run -p 8000:8000 -e UNISTAX_AGENT_API_JWT_SECRET=<32+ chars> \
#       -v agent-data:/data unistax-agent-api
#
# Run exactly one container: agents, scheduling and the event stream are held in
# process memory (see AGENTS.md > "Running the API").

FROM python:3.12-slim AS builder
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /build
COPY pyproject.toml README.md MANIFEST.in ./
COPY src ./src
RUN python -m venv /opt/venv \
 && /opt/venv/bin/pip install ".[agents-api]"

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH" \
    UNISTAX_AGENT_API_DATABASE_URL="sqlite+aiosqlite:////data/agents.db"

RUN useradd --system --uid 10001 --home-dir /app --shell /usr/sbin/nologin unistax \
 && mkdir -p /app /data \
 && chown unistax /app /data

COPY --from=builder /opt/venv /opt/venv

USER unistax
WORKDIR /app
VOLUME ["/data"]
EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=3s --start-period=15s --retries=3 \
    CMD ["python", "-c", "import urllib.request as u; u.urlopen('http://127.0.0.1:8000/health/ready', timeout=2)"]

CMD ["python", "-m", "unistax.agents.api"]
