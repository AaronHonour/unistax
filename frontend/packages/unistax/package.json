{
  "name": "@unistax/frontend",
  "version": "0.5.0",
  "description": "Composable frontend components for building unified full-stack applications",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.{js,ts,tsx}",
    "lint:fix": "eslint src/**/*.{js,ts,tsx} --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,ts,tsx,json,css,md}\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "unistax",
    "composable",
    "full-stack",
    "frontend",
    "components"
  ],
  "author": "Aaron Honour <aaron@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AaronHonour/unistax.git",
    "directory": "frontend"
  },
  "bugs": {
    "url": "https://github.com/AaronHonour/unistax/issues"
  },
  "homepage": "https://github.com/AaronHonour/unistax#readme",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "postcss": "^8.5.6",
    "prettier": "^3.0.0",
    "rollup": "^4.0.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "tailwindcss": "^4.1.17",
    "ts-jest": "^29.1.0",
    "typescript": "^5.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
